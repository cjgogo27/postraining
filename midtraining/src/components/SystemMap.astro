  .lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.lanes>section{margin:0;padding:.7rem;background:var(--sl-color-accent-low);border-radius:.4rem}.lanes h3{font-size:1rem;margin:0}.lanes ol{padding-left:1.2rem}.lanes p,.note{font-size:.85rem}.support{display:flex;flex-wrap:wrap;gap:.4rem}.support>span{margin:0;border:1px dashed var(--sl-color-gray-4);border-radius:.3rem;padding:.4rem;font-size:.85rem}
  @media(max-width:50rem){.lanes{grid-template-columns:1fr}}
</style>
