{
  "name": "posttraining-tutorial",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && astro build --root ./midtraining",
    "dev:midtraining": "astro dev --root ./midtraining --host 127.0.0.1",
    "build:midtraining": "astro build --root ./midtraining",
    "preview": "astro preview --host 127.0.0.1",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-midtraining.mjs",
    "check:built": "node scripts/check-built.mjs",
    "test": "node --test scripts/test-teaching.mjs scripts/test-rl.mjs scripts/test-midtraining.mjs"
  },
  "overrides": {
    "rolldown": "1.2.13"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.1",
    "katex": "0.18.7",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  }
}
